# LINE Developers console → your Messaging API channel → "Basic settings" / "Messaging API"
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Model used for parsing text/images. claude-sonnet-5 gives the best accuracy for
# reading scale photos and estimating meal calories; claude-haiku-4-5-20251001 is
# cheaper/faster if cost matters more than accuracy.
CLAUDE_MODEL=claude-sonnet-5

# Local port (hosting platforms usually set PORT themselves)
PORT=3000
